{
  "name": "favr/favr-events",
  "description": "Events and a community calendar for Chambers of Commerce and associations, with member-submitted events. Part of Favr Sites.",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "repositories": [
    {
      "type": "vcs",
      "url": "https://github.com/26am/favr-core"
    }
  ],
  "require": {
    "php": ">=8.1",
    "favr/core": "^0.4.1"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.6",
    "brain/monkey": "^2.6",
    "wp-coding-standards/wpcs": "^3.1",
    "phpcompatibility/phpcompatibility-wp": "^2.1",
    "brianhenryie/strauss": "^0.30"
  },
  "autoload": {
    "psr-4": {
      "FavrEvents\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "FavrEvents\\Tests\\": "tests/"
    }
  },
  "extra": {
    "strauss": {
      "target_directory": "vendor-prefixed",
      "namespace_prefix": "FavrEvents\\Vendor\\",
      "classmap_prefix": "FavrEvents_Vendor_",
      "packages": [
        "favr/core"
      ],
      "delete_vendor_packages": false,
      "update_call_sites": false,
      "exclude_from_copy": {
        "file_patterns": [
          "#/tests/#",
          "#phpunit\\.xml#",
          "#phpcs\\.xml#"
        ]
      }
    }
  },
  "config": {
    "platform": {
      "php": "8.1.0"
    },
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  },
  "scripts": {
    "prefix": [
      "vendor/bin/strauss",
      "@php -r \"if (!is_dir('assets/core')) mkdir('assets/core', 0777, true); foreach (['fields.css','fields.js','front-fields.css','uploader.js'] as \\$f) copy('vendor/favr/core/assets/'.\\$f, 'assets/core/'.\\$f);\""
    ],
    "post-install-cmd": [
      "@prefix"
    ],
    "post-update-cmd": [
      "@prefix"
    ],
    "test": "phpunit",
    "lint": "phpcs"
  }
}
